# AUTH (REQUIRED)
NEXTAUTH_SECRET=REPLACE_WITH_ANY_LONG_RANDOM_STRING
NEXTAUTH_URL=https://YOUR_VERCEL_URL.vercel.app

# OAUTH (OPTIONAL - leave as false if no keys)
NEXT_PUBLIC_GOOGLE_ENABLED=false
NEXT_PUBLIC_APPLE_ENABLED=false
GOOGLE_CLIENT_ID=DISABLED_ADD_LATER
GOOGLE_CLIENT_SECRET=DISABLED_ADD_LATER
APPLE_ID=DISABLED_ADD_LATER
APPLE_SECRET=DISABLED_ADD_LATER

# BACKEND URL
NEXT_PUBLIC_API_URL=https://YOUR_RENDER_BACKEND_URL.onrender.com
